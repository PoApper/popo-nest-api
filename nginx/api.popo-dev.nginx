# Included from the nginx http context.
limit_req_zone $binary_remote_addr zone=report_download_dev:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=report_connections_dev:10m;

server {
    server_name api.popo-dev.poapper.club;
    client_max_body_size 10M;

    location ~ ^/activity-report/[^/]+/file/?$ {
        limit_req zone=report_download_dev burst=10 nodelay;
        limit_req_status 429;
        limit_conn report_connections_dev 4;
        limit_conn_status 429;
        proxy_buffering off;
        proxy_pass http://localhost:6000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 20 MiB document limit plus room for multipart boundaries and metadata.
    location ~ ^/activity-report(?:/[^/]+)?/?$ {
        client_max_body_size 21M;
        proxy_pass http://localhost:6000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

   location / {
        proxy_pass http://localhost:6000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
